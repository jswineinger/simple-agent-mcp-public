# mcp-server.env — copy to mcp-server.env and fill in values
# mcp-server.env is gitignored; this example file is committed.

# ── Topology ─────────────────────────────────────────────────────────────
# Where the agent and mcp-server live. Defaults assume both run on one box.
# Neither var below is read by mcp_server.py — they're declared here purely
# so this file shows the same topology as agent/agent.env.example. The
# actual bind address is MCP_SERVER_HOST below.
AGENT_IP=127.0.0.1
MCPSERVER_IP=127.0.0.1

# ── Network ───────────────────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# ── Auth ──────────────────────────────────────────────────────────────────
# Shared bearer token the agent must present as "Authorization: Bearer <token>"
# on every request. Required — the server refuses to start without one
# (fail closed; see mcp_server.py's __main__). Generate a real value with:
#   openssl rand -hex 32
# This same value must be copied into MCP_AUTH_TOKEN in agent/agent.env
# on the agent VM.
MCP_AUTH_TOKEN=changeme-generate-a-real-token

# ── Debug / test-harness logging ────────────────────────────────────────
# Off by default. When on, the OWASP test-harness tools (see
# test_harness/canary.py) append every call to
# test_harness/logs/tool_invocations.jsonl. Same name/concept as agent.env's
# DEBUG_JSON, set independently per service. SENSITIVE: contains planted
# injection payloads and simulated PII/secrets when the harness is in use.
# Never commit or share this file.
DEBUG_JSON=false
