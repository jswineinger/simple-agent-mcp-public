# agent.env — copy to agent.env and fill in values
# agent.env is gitignored; this example file is committed.

# ── Topology ──────────────────────────────────────────────────────────────
# Where mcp-server lives. Defaults assume agent and mcp-server run on one
# box. Splitting onto separate VMs is just replacing 127.0.0.1 with the real
# IP below — AND making the matching edit in mcp-server/mcp-server.env on
# the mcp-server host (it declares the same variables so both files show the
# topology at a glance).
# AGENT_IP: this box's own address — informational only, not read by app.py
AGENT_IP=127.0.0.1
MCPSERVER_IP=127.0.0.1
# MCP_SERVER_PORT must match MCP_SERVER_PORT in mcp-server.env
MCP_SERVER_PORT=8765

# ── LLM endpoints ─────────────────────────────────────────────────────────
# Provider-neutral: any OpenAI-compatible endpoint works for either slot.
# Both URLs are full base URLs INCLUDING the version segment (e.g. /v1) —
# the agent appends /chat/completions. Values below are examples (an
# Ollama-served local model, Anthropic's OpenAI-compatible endpoint).
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
PUBLIC_LLM_URL=https://api.anthropic.com/v1
AI_PROXY_URL=https://<FAIG_FQDN>/ai/openai/v1

# ── Models ────────────────────────────────────────────────────────────────
# FAIG 8.0.2 routes on a slug prepended to the model name (format: <slug>-<model>),
# so the proxied name differs from the direct name — for both the local and
# public flows.
DIRECT_LOCAL_MODEL=qwen2.5:14b
PROXY_LOCAL_MODEL=<slug>-qwen2.5:14b
DIRECT_PUBLIC_MODEL=claude-sonnet-4-6
PROXY_PUBLIC_MODEL=<slug>-claude-sonnet-4-6

# ── Auth ──────────────────────────────────────────────────────────────────
# Bearer token for the local LLM (also the placeholder the AI Proxy key
# validation overrides). Many self-hosted servers ignore it; any value works.
API_KEY=ollama
# Bearer token for the public LLM — Direct + Public mode only. In AI Proxy
# mode the proxy holds the upstream credential itself.
PUBLIC_API_KEY=sk-...

# ── AI Proxy API Key Validation ───────────────────────────────────────────
# On by default — FAIG 8.0.2 requires a virtual key on every request. Each AI
# Flow (Local, Public) has its own independent Settings > API Keys entry,
# so the key is split by flow below. AI_PROXY_VALIDATION_HEADER must match
# the flows' "Custom Authentication Header" (default: Authorization → sent
# as "Bearer <key>"; any other header is sent as the raw key value) — shared
# across both flows here; split that too if your two Flows use different
# headers.
AI_PROXY_VALIDATION_ENABLED=true
# FAIG 8.0.2 requires a virtual key — one per AI Flow
AI_PROXY_VALIDATION_KEY_LOCAL=faig.....
AI_PROXY_VALIDATION_KEY_PUBLIC=faig.....
AI_PROXY_VALIDATION_HEADER=Authorization

# ── TLS ───────────────────────────────────────────────────────────────────
# Set to true only if the AI Proxy has a trusted cert
VERIFY_TLS=false

# ── App ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── MCP server — JSON-RPC 2.0 over HTTP ──────────────────────────────────
# MCP_SERVER_URL is derived from MCPSERVER_IP + MCP_SERVER_PORT above — not
# set here.
# Bearer token — must match MCP_AUTH_TOKEN in mcp-server/mcp-server.env on
# the mcp-server host. Required; without it every tool call is rejected (401).
MCP_AUTH_TOKEN=changeme-generate-a-real-token
# Set to false to run the agent with no local MCP tools at all — the agent
# never attempts to connect to mcphost (same idea as DLPTEST_ENABLED below,
# for the local backend instead of the public one).
MCP_SERVER_ENABLED=true

# ── Public MCP server (dlptest — external, Streamable HTTP) ────────────────
# Real JSON-RPC 2.0 MCP over HTTPS. Public/unauthenticated DLP test server.
# Tools are exposed to the model as dlptest__<toolname> in ALL four modes.
# Note: the JSON-RPC endpoint lives on mcp.dlptest.com, not dlptest.com —
# https://dlptest.com/mcp/ is documentation only.
DLPTEST_MCP_URL=https://mcp.dlptest.com/api/mcp/
DLPTEST_ENABLED=false
MCP_HTTP_TIMEOUT=30
# Startup connect retries per MCP backend (mcphost and dlptest). A backend
# that never connects is left out until the agent restarts.
MCP_CONNECT_ATTEMPTS=10
MCP_CONNECT_DELAY=3
# Tools left out of tools[] unless a request opts in via include_tools (the
# UI's MCP03 - Poisoned chip does). An AI Proxy that scans tool definitions
# would otherwise block every request because of one of these.
MCP_OPT_IN_TOOLS=mcphost__get_customer_record_poisoned

# ── Debug / test-harness logging ────────────────────────────────────────
# Off by default. When on, writes raw outbound/inbound LLM traffic (full
# messages, tool calls/results) to debug_json.log — see app.py's DEBUG_JSON
# comment block. Also required for test_harness/report.py to have anything
# to correlate on the agent side. SENSITIVE: contains planted injection
# payloads and simulated PII/secrets when the harness is in use. Never
# commit or share this file.
DEBUG_JSON=false
